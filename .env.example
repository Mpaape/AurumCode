# ---------------------------------------------------------------------------
# Documentation generator (cmd/regenerate-docs)
#
# Provider-agnostic: any OpenAI-compatible HTTP endpoint works and there is no
# default URL, so you must supply your own. All of these are optional - with
# none of them set the generator still produces documentation and only skips
# the AI welcome page.
# ---------------------------------------------------------------------------
LLM_API_KEY=""                                        # Read at cmd/regenerate-docs/main.go:65
LLM_BASE_URL="https://llm.example.com/v1"             # Read at cmd/regenerate-docs/main.go:66 - required together with LLM_API_KEY
LLM_MODEL="gpt-4o-mini"                               # Read at cmd/regenerate-docs/main.go:73 - defaults to gpt-4o-mini

# Pipeline knobs, declared at cmd/regenerate-docs/main.go:32-38.
AURUMCODE_SOURCE_DIR="."                              # Read at cmd/regenerate-docs/main.go:325 - tree to scan
AURUMCODE_OUTPUT_DIR=".aurumcode"                     # Read at cmd/regenerate-docs/main.go:338 - where generated markdown is written
AURUMCODE_DOCS_DIR=""                                 # Read at cmd/regenerate-docs/main.go:362 - where index.md and _config.yml are written (defaults to AURUMCODE_OUTPUT_DIR)
AURUMCODE_LANGUAGES=""                                # Read at cmd/regenerate-docs/main.go:363 - empty = every registered language
AURUMCODE_INCREMENTAL="false"                         # Read at cmd/regenerate-docs/main.go:340 - true documents only files changed since the last run
AURUMCODE_VALIDATE_JEKYLL="false"                     # Read at cmd/regenerate-docs/main.go:345 - true runs bundle exec jekyll build in the docs directory after generation
AURUMCODE_DEPLOY_GH_PAGES="false"                     # Read at cmd/regenerate-docs/main.go:350 - setting this to true does NOT deploy: resolveConfig (main.go:353-357) returns an error and the run fails; publish the output directory with a dedicated step instead

# Security: opt-in code execution for Rust and C#
# AURUMCODE_ALLOW_REPO_CODE_EXECUTION=""               # Read at cmd/regenerate-docs/main.go:432, declared at cmd/regenerate-docs/repo_code_execution.go:43
# Rust and C# extractors require their build tools to compile the documented repository.
# This necessarily executes code from the repository (build.rs, proc-macros, MSBuild tasks).
# Set to "rust" and/or "csharp" (comma-separated) to opt-in. DEFAULT DISABLED for security.
# Only enable on repositories where every branch this runs on is trusted.

# ---------------------------------------------------------------------------
# Task Master keys (.taskmaster tooling only - not read by the generator).
# At least one is required to enable the respective provider.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Also the generator's fallback provider (main.go:67). Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"
MISTRAL_API_KEY="your_mistral_key_here"
XAI_API_KEY="YOUR_XAI_KEY_HERE"
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Requires an endpoint in .taskmaster/config.json
OLLAMA_API_KEY="your_ollama_api_key_here"             # Only for remote Ollama servers that require authentication
GITHUB_API_KEY="your_github_api_key_here"             # Format: ghp_... or github_pat_...
