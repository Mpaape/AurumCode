#!/usr/bin/env bash
#
# AUR-355/AC-001 -- RootIgnoreSuiteV1 gate over the child set [AUR-390, AUR-391].
#
# What this program refuses to do
#
#   It never reads a verdict. The previous revision accepted the literal string
#   `pass` written into `tests/gates/legacy/AUR-355/suite.tsv`, so anyone able to
#   write that file could close the suite without a single child having run. A
#   value a writer controls is a claim, never proof.
#
# What it does instead
#
#   1. The expected child set is EMBEDDED in this file, literally. It is not
#      derived from any repository artifact, so no artifact can add, drop or
#      rename a child.
#   2. Every child's acceptance program is RE-EXECUTED and only its raw exit
#      code is believed. No field printed by a child, and no field stored in a
#      manifest, can substitute for that observation.
#   3. Every digest is RECOMPUTED here over actual bytes -- the child program on
#      disk and the child's captured stdout. A manifest digest is compared
#      against the recomputed value; a digest a file declares about itself is
#      worth nothing and is never used.
#   4. `tests/gates/legacy/AUR-355/suite.tsv` is still required, but only as a
#      declaration that must AGREE with the observed run. It can only make this
#      gate stricter; it can never make it pass. Verdict, both digests, the
#      candidate identity, the exact set and the row count are all checked
#      against ground truth established in step 2 and 3.
#
# Exit codes, deliberately disjoint:
#   0   every embedded child re-executed and exited 0, and the manifest agrees
#       with the recomputed observation; stdout carries one JSON object.
#   1   behavioral RED, message `AUR-355/AC-001/<reason>`.
#   64  unknown selector.
#   69  infrastructure, message `AUR-355/AC-001/infrastructure/<reason>`. A
#       missing utility, an unusable temp dir, a child that itself reported
#       infrastructure, or a child that ran past the deadline is an environment
#       diagnosis, never a verdict. Inconclusive is never reported as red.
set -euo pipefail

export LC_ALL=C
umask 077

readonly card='AUR-355'
readonly scenario='AC-001'

# Embedded, literal child set. The single source of truth for this gate.
readonly expected_children=('AUR-390' 'AUR-391')
readonly child_deadline_seconds=20
readonly max_manifest_bytes=4194304
readonly max_manifest_rows=128
readonly max_child_stdout_bytes=1048576

selector="${1:-AC-001}"
case "$selector" in
  AC-001|ContractAUR355|IntegrationAUR355|E2EAUR355) ;;
  *) printf '%s/%s/unknown-selector\n' "$card" "$scenario" >&2; exit 64 ;;
esac

fail() {
  printf '%s/%s/%s\n' "$card" "$scenario" "$1" >&2
  exit 1
}

infra() {
  printf '%s/%s/infrastructure/%s\n' "$card" "$scenario" "$1" >&2
  exit 69
}

work=''
cleanup() {
  [[ -z "$work" ]] || rm -rf -- "$work"
}
trap cleanup EXIT INT TERM HUP

# A child must never be able to re-enter this gate.
if [[ -n "${AURUM_SUITE_GATE_ACTIVE:-}" ]]; then
  infra "recursive-invocation:${AURUM_SUITE_GATE_ACTIVE}"
fi

for tool in sha256sum mktemp timeout wc sed grep sort; do
  command -v "$tool" >/dev/null 2>&1 || infra "missing-utility:$tool"
done

repo_root="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)" || infra repo-root-unresolvable
[[ -d "$repo_root/tests/acceptance" ]] || infra "acceptance-dir-missing:tests/acceptance"

work="$(mktemp -d)" || infra tempdir-unavailable
[[ -d "$work" && -w "$work" ]] || infra tempdir-unusable
mkdir -p -- "$work/child-tmp" || infra tempdir-unusable

digest_of() {
  local line
  line="$(sha256sum -- "$1")" || infra "sha256-failed:$(basename -- "$1")"
  printf '%s' "${line%% *}"
}

# Only a well-formed diagnostic token from a child is echoed back. Child output
# is untrusted data: it is never interpolated raw into this gate's messages.
sanitized_child_reason() {
  local raw='' clean=''
  read -r raw <"$1" 2>/dev/null || raw=''
  clean="$(printf '%s' "${raw:0:120}" | tr -cd 'A-Za-z0-9/_.:-')"
  printf '%s' "$clean"
}

records="$work/records.tsv"
identity_records="$work/identity.tsv"
: >"$records"
: >"$identity_records"

expected_count="${#expected_children[@]}"
observed_identity=''
identity_seen=0
identity_missing=0

seen_ids=''
for child in "${expected_children[@]}"; do
  case " $seen_ids " in
    *" $child "*) fail "child_duplicate:$child" ;;
  esac
  seen_ids="$seen_ids $child"
  [[ "$child" != "$card" ]] || infra "self-referential-child:$child"

  child_prog="$repo_root/tests/acceptance/$child.sh"
  if [[ ! -f "$child_prog" || -L "$child_prog" || ! -s "$child_prog" ]]; then
    fail "ignore_manifest_missing:$child:tests/acceptance/$child.sh"
  fi
  prog_digest="$(digest_of "$child_prog")"

  out="$work/$child.out"
  err="$work/$child.err"
  # Least privilege: the child inherits a minimal environment. The secret canary
  # is deliberately forwarded so the leak assertion below stays meaningful.
  child_env=(
    env -i
    PATH="${PATH:-/usr/bin:/bin}"
    HOME="${HOME:-/nonexistent}"
    LC_ALL=C
    TMPDIR=$work/child-tmp
    AURUM_SUITE_GATE_ACTIVE="$card"
  )
  if [[ -n "${AURUM_SECRET_CANARY:-}" ]]; then
    child_env+=("AURUM_SECRET_CANARY=$AURUM_SECRET_CANARY")
  fi
  # Raw exit status, never through a pipe: a pipe would swallow the producer's
  # status and that status is the only thing this gate believes.
  set +e
  "${child_env[@]}" timeout -k 5 "$child_deadline_seconds" \
    bash -- "$child_prog" AC-001 >"$out" 2>"$err"
  child_rc=$?
  set -e

  case "$child_rc" in
    0) ;;
    69) infra "child_infrastructure:$child:$(sanitized_child_reason "$err")" ;;
    64) infra "child_selector_rejected:$child" ;;
    124|137) infra "child_timeout:$child:${child_deadline_seconds}s" ;;
    *) fail "child_not_pass:$child:rc=$child_rc:$(sanitized_child_reason "$err")" ;;
  esac

  if [[ -n "${AURUM_SECRET_CANARY:-}" ]] && grep -qF -- "$AURUM_SECRET_CANARY" "$out" "$err"; then
    fail "secret_leak:$child"
  fi

  out_bytes="$(wc -c <"$out")"
  [[ "$out_bytes" -le "$max_child_stdout_bytes" ]] || fail "child_output_oversized:$child"
  # A child that exits 0 without owning the record it printed is not evidence.
  grep -q "\"card\":\"$child\"" "$out" || fail "child_not_pass:$child:record_not_owned"
  grep -q '"result":"pass"' "$out" || fail "child_not_pass:$child:record_not_pass"
  stdout_digest="$(digest_of "$out")"

  sed -n 's/.*"identity"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9:_.-]\{1,128\}\)".*/\1/p' "$out" >"$work/identity.raw"
  child_identity=''
  read -r child_identity <"$work/identity.raw" 2>/dev/null || child_identity=''
  if [[ -n "$child_identity" ]]; then
    identity_seen=$((identity_seen + 1))
    if [[ -z "$observed_identity" ]]; then
      observed_identity="$child_identity"
    elif [[ "$observed_identity" != "$child_identity" ]]; then
      fail "candidate_identity_mismatch:$child"
    fi
  else
    identity_missing=$((identity_missing + 1))
  fi

  printf '%s\t%s\t%s\t%s\n' "$child" "$child_rc" "$prog_digest" "$stdout_digest" >>"$records"
  printf '%s\t%s\n' "$child" "$prog_digest" >>"$identity_records"
done

# Mixed identity reporting across the set is a divergence, not a default.
if [[ "$identity_seen" -gt 0 && "$identity_missing" -gt 0 ]]; then
  fail candidate_identity_mismatch
fi
if [[ -z "$observed_identity" ]]; then
  # No child declares an identity: derive one the coordinator can recompute
  # from the ordered child ids and their on-disk program digests.
  observed_identity="sha256:$(digest_of "$identity_records")"
fi
suite_digest="sha256:$(digest_of "$records")"

# The manifest is a declaration to be checked, never a source of verdicts.
manifest="$repo_root/tests/gates/legacy/$card/suite.tsv"
[[ -e "$manifest" ]] || fail "ignore_manifest_missing:tests/gates/legacy/$card/suite.tsv"
[[ -f "$manifest" && ! -L "$manifest" && -s "$manifest" ]] || fail suite_manifest_invalid
manifest_bytes="$(wc -c <"$manifest")"
[[ "$manifest_bytes" -le "$max_manifest_bytes" ]] || fail suite_manifest_oversized
manifest_rows="$(wc -l <"$manifest")"
[[ "$manifest_rows" -le "$max_manifest_rows" ]] || fail suite_manifest_oversized

row_count=0
claimed=''
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -n "$line" ]] || continue
  row_count=$((row_count + 1))
  [[ "$row_count" -le "$max_manifest_rows" ]] || fail suite_manifest_oversized

  m_id=''; m_verdict=''; m_prog=''; m_stdout=''; m_identity=''; m_rest=''
  IFS=$'\t' read -r m_id m_verdict m_prog m_stdout m_identity m_rest <<<"$line"
  [[ -n "$m_identity" && -z "$m_rest" ]] || fail suite_manifest_invalid

  case " ${expected_children[*]} " in
    *" $m_id "*) ;;
    *) fail "child_unexpected:$m_id" ;;
  esac
  case " $claimed " in
    *" $m_id "*) fail "child_duplicate:$m_id" ;;
  esac
  claimed="$claimed $m_id"

  observed_row=''
  while IFS= read -r rec; do
    [[ "${rec%%$'\t'*}" == "$m_id" ]] || continue
    observed_row="$rec"
    break
  done <"$records"
  [[ -n "$observed_row" ]] || fail "ignore_manifest_missing:$m_id"

  IFS=$'\t' read -r _o_id o_rc o_prog o_stdout <<<"$observed_row"
  [[ "$m_verdict" == 'pass' && "$o_rc" == '0' ]] || fail "child_not_pass:$m_id"
  [[ "$m_prog" == "sha256:$o_prog" ]] || fail "child_digest_mismatch:$m_id:program"
  [[ "$m_stdout" == "sha256:$o_stdout" ]] || fail "child_digest_mismatch:$m_id:stdout"
  [[ "$m_identity" == "$observed_identity" ]] || fail "candidate_identity_mismatch:$m_id"
done <"$manifest"

[[ "$row_count" -eq "$expected_count" ]] || fail "ignore_manifest_missing:rows=$row_count:expected=$expected_count"

ids_json=''
for child in "${expected_children[@]}"; do
  if [[ -z "$ids_json" ]]; then
    ids_json="\"$child\""
  else
    ids_json="$ids_json,\"$child\""
  fi
done

printf '{"card":"%s","scenario":"%s","selector":"%s","children":%s,"child_ids":[%s],"identity":"%s","suite_digest":"%s","evidence":"re-executed","result":"pass"}\n' \
  "$card" "$scenario" "$selector" "$expected_count" "$ids_json" "$observed_identity" "$suite_digest"
