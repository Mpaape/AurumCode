{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/docs-tool-offline-profile.schema.json",
  "title": "AurumCode offline documentation tool profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "generator", "generator_cgo", "generator_root", "renderer", "plugin_set", "native_site_tool", "dynamic_plugin", "remote_fetch", "snippet_execution", "snippet_languages", "fixture_source", "fixture_root", "output_mode", "output_root", "host_output", "host_filesystem", "subprocess", "max_documents", "max_document_bytes", "max_output_bytes", "render_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.docs-tool-offline-profile"},
    "version": {"const": 1},
    "profile": {"const": "docs-tool-offline-v1"},
    "lock": {"const": ".board/locks/oci/docs-tool-offline-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "generator": {"const": "digest-pinned"},
    "generator_cgo": {"const": false},
    "generator_root": {"const": "/tmp/aurum-docs-tool"},
    "renderer": {"const": "digest-pinned"},
    "plugin_set": {"const": "digest-pinned"},
    "native_site_tool": {"const": "denied"},
    "dynamic_plugin": {"const": "denied"},
    "remote_fetch": {"const": "denied"},
    "snippet_execution": {"const": "denied"},
    "snippet_languages": {"const": ["bash", "go", "json"]},
    "fixture_source": {"const": "local"},
    "fixture_root": {"const": "/tmp/aurum-docs-fixtures"},
    "output_mode": {"const": "ephemeral"},
    "output_root": {"const": "/tmp/aurum-docs-output"},
    "host_output": {"const": "denied"},
    "host_filesystem": {"const": "denied"},
    "subprocess": {"const": "denied"},
    "max_documents": {"const": 64},
    "max_document_bytes": {"const": 1048576},
    "max_output_bytes": {"const": 33554432},
    "render_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "CGO_ENABLED", "AURUM_DOCS_GENERATOR_ROOT", "AURUM_DOCS_FIXTURE_ROOT", "AURUM_DOCS_OUTPUT_ROOT", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "CGO_ENABLED": {"const": "0"}, "AURUM_DOCS_GENERATOR_ROOT": {"const": "/tmp/aurum-docs-tool"}, "AURUM_DOCS_FIXTURE_ROOT": {"const": "/tmp/aurum-docs-fixtures"}, "AURUM_DOCS_OUTPUT_ROOT": {"const": "/tmp/aurum-docs-output"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
