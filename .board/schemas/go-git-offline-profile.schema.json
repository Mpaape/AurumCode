{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/go-git-offline-profile.schema.json",
  "title": "AurumCode offline Go Git profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "git_fixture", "git_fixture_root", "host_checkout", "credential_helpers", "hooks", "signing", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.go-git-offline-profile"},
    "version": {"const": 1},
    "profile": {"const": "go-git-offline-v1"},
    "lock": {"const": ".board/locks/oci/go-git-offline-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 120},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 256},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "git_fixture": {"const": "ephemeral"},
    "git_fixture_root": {"const": "/tmp/aurum-git-fixture"},
    "host_checkout": {"const": "denied"},
    "credential_helpers": {"const": "denied"},
    "hooks": {"const": "denied"},
    "signing": {"const": "denied"},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_TERMINAL_PROMPT", "GIT_ASKPASS", "GIT_ALLOW_PROTOCOL", "GIT_CEILING_DIRECTORIES"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "GIT_CONFIG_NOSYSTEM": {"const": "1"}, "GIT_CONFIG_GLOBAL": {"const": "/dev/null"}, "GIT_CONFIG_SYSTEM": {"const": "/dev/null"}, "GIT_TERMINAL_PROMPT": {"const": "0"}, "GIT_ASKPASS": {"const": "/bin/false"}, "GIT_ALLOW_PROTOCOL": {"const": "none"}, "GIT_CEILING_DIRECTORIES": {"const": "/tmp"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
