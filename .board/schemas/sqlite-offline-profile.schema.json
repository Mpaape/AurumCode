{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/sqlite-offline-profile.schema.json",
  "title": "AurumCode offline SQLite state store profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "sqlite_driver", "sqlite_driver_cgo", "database_mode", "database_root", "host_database", "extension_loading", "remote_uri", "implicit_persistence", "attach_database", "journal_mode", "max_database_bytes", "max_open_connections", "busy_timeout_ms", "query_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.sqlite-offline-profile"},
    "version": {"const": 1},
    "profile": {"const": "sqlite-offline-v1"},
    "lock": {"const": ".board/locks/oci/sqlite-offline-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "sqlite_driver": {"const": "digest-pinned"},
    "sqlite_driver_cgo": {"const": false},
    "database_mode": {"const": "ephemeral"},
    "database_root": {"const": "/tmp/aurum-sqlite-state"},
    "host_database": {"const": "denied"},
    "extension_loading": {"const": "denied"},
    "remote_uri": {"const": "denied"},
    "implicit_persistence": {"const": "denied"},
    "attach_database": {"const": "denied"},
    "journal_mode": {"const": "memory"},
    "max_database_bytes": {"const": 33554432},
    "max_open_connections": {"const": 4},
    "busy_timeout_ms": {"const": 2000},
    "query_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "CGO_ENABLED", "AURUM_SQLITE_DATABASE_ROOT", "SQLITE_TMPDIR", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "CGO_ENABLED": {"const": "0"}, "AURUM_SQLITE_DATABASE_ROOT": {"const": "/tmp/aurum-sqlite-state"}, "SQLITE_TMPDIR": {"const": "/tmp/aurum-sqlite-state"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
