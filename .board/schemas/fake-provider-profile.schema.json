{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/fake-provider-profile.schema.json",
  "title": "AurumCode offline fake provider profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "provider_endpoint", "dns", "egress", "api_key", "credential_sources", "response_scripts", "response_scripts_root", "request_timeout_seconds", "max_response_bytes", "max_responses", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.fake-provider-profile"},
    "version": {"const": 1},
    "profile": {"const": "fake-provider-v1"},
    "lock": {"const": ".board/locks/oci/fake-provider-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "provider_endpoint": {"const": "http://127.0.0.1:8080/v1"},
    "dns": {"const": "denied"},
    "egress": {"const": "denied"},
    "api_key": {"const": "absent"},
    "credential_sources": {"const": "denied"},
    "response_scripts": {"const": "digest-pinned"},
    "response_scripts_root": {"const": "/tmp/aurum-fake-provider"},
    "request_timeout_seconds": {"const": 5},
    "max_response_bytes": {"const": 65536},
    "max_responses": {"const": 64},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "OPENAI_API_KEY", "OPENAI_BASE_URL", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "OPENAI_API_KEY": {"const": ""}, "OPENAI_BASE_URL": {"const": "http://127.0.0.1:8080/v1"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
