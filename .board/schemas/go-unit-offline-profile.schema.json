{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/go-unit-offline-profile.schema.json",
  "title": "AurumCode sealed offline Go unit profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "pull", "tmpfs", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes"],
  "properties": {
    "schema": {"const": "aurum.container-profile"},
    "version": {"const": 1},
    "profile": {"const": "go-unit-offline-v1"},
    "lock": {"const": ".board/locks/oci/go-unit-offline-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "memory_mb": {"type": "integer", "minimum": 64, "maximum": 4096},
    "cpu_millis": {"type": "integer", "minimum": 100, "maximum": 4000},
    "pids_limit": {"type": "integer", "minimum": 16, "maximum": 4096},
    "tmpfs_mb": {"type": "integer", "minimum": 8, "maximum": 1024},
    "stdout_limit_bytes": {"type": "integer", "minimum": 4096, "maximum": 1048576},
    "stderr_limit_bytes": {"type": "integer", "minimum": 4096, "maximum": 1048576},
    "max_input_files": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456}
  }
}
