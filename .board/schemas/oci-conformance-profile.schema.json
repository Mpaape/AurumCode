{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/oci-conformance-profile.schema.json",
  "title": "AurumCode OCI conformance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "orchestrator", "orchestrator_root", "probe", "probe_root", "probe_image_set", "probe_cgo", "probe_output", "probe_verdict_authority", "probe_writable_roots", "verdict_authority", "report_mode", "report_root", "supported_engines", "unsupported_engine", "engine_invocations", "engine_socket", "engine_api", "host_engine", "egress", "host_checkout", "host_filesystem", "subprocess", "max_probes", "max_probe_bytes", "max_report_bytes", "probe_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.oci-conformance-profile"},
    "version": {"const": 1},
    "profile": {"const": "oci-conformance-v1"},
    "lock": {"const": ".board/locks/oci/oci-conformance-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "orchestrator": {"const": "trusted"},
    "orchestrator_root": {"const": "/tmp/aurum-oci-orchestrator"},
    "probe": {"const": "untrusted"},
    "probe_root": {"const": "/tmp/aurum-oci-probes"},
    "probe_image_set": {"const": "digest-pinned"},
    "probe_cgo": {"const": false},
    "probe_output": {"const": "untrusted-observation"},
    "probe_verdict_authority": {"const": "denied"},
    "probe_writable_roots": {"const": ["/tmp/aurum-oci-probes"]},
    "verdict_authority": {"const": "orchestrator"},
    "report_mode": {"const": "ephemeral"},
    "report_root": {"const": "/tmp/aurum-oci-reports"},
    "supported_engines": {"const": ["docker", "podman"]},
    "unsupported_engine": {"const": "denied"},
    "engine_invocations": {"const": 0},
    "engine_socket": {"const": "denied"},
    "engine_api": {"const": "denied"},
    "host_engine": {"const": "denied"},
    "egress": {"const": "denied"},
    "host_checkout": {"const": "denied"},
    "host_filesystem": {"const": "denied"},
    "subprocess": {"const": "denied"},
    "max_probes": {"const": 1024},
    "max_probe_bytes": {"const": 65536},
    "max_report_bytes": {"const": 1048576},
    "probe_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "CGO_ENABLED", "AURUM_OCI_ORCHESTRATOR_ROOT", "AURUM_OCI_PROBE_ROOT", "AURUM_OCI_REPORT_ROOT", "DOCKER_HOST", "CONTAINER_HOST", "DOCKER_CONFIG", "DOCKER_API_VERSION", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "CGO_ENABLED": {"const": "0"}, "AURUM_OCI_ORCHESTRATOR_ROOT": {"const": "/tmp/aurum-oci-orchestrator"}, "AURUM_OCI_PROBE_ROOT": {"const": "/tmp/aurum-oci-probes"}, "AURUM_OCI_REPORT_ROOT": {"const": "/tmp/aurum-oci-reports"}, "DOCKER_HOST": {"const": ""}, "CONTAINER_HOST": {"const": ""}, "DOCKER_CONFIG": {"const": "/dev/null"}, "DOCKER_API_VERSION": {"const": ""}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
