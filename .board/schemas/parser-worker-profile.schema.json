{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/parser-worker-profile.schema.json",
  "title": "AurumCode offline parser worker profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "worker", "worker_root", "grammar_set", "grammar_set_root", "code_execution", "host_filesystem", "subprocess", "blob_source", "max_blob_bytes", "max_blobs", "parse_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.parser-worker-profile"},
    "version": {"const": 1},
    "profile": {"const": "parser-worker-v1"},
    "lock": {"const": ".board/locks/oci/parser-worker-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "worker": {"const": "digest-pinned"},
    "worker_root": {"const": "/tmp/aurum-parser-worker"},
    "grammar_set": {"const": "digest-pinned"},
    "grammar_set_root": {"const": "/tmp/aurum-parser-grammars"},
    "code_execution": {"const": "denied"},
    "host_filesystem": {"const": "denied"},
    "subprocess": {"const": "denied"},
    "blob_source": {"const": "stdin"},
    "max_blob_bytes": {"const": 1048576},
    "max_blobs": {"const": 256},
    "parse_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "AURUM_PARSER_WORKER_ROOT", "AURUM_PARSER_GRAMMAR_ROOT", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "AURUM_PARSER_WORKER_ROOT": {"const": "/tmp/aurum-parser-worker"}, "AURUM_PARSER_GRAMMAR_ROOT": {"const": "/tmp/aurum-parser-grammars"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
