{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/polyglot-toolchain-profile.schema.json",
  "title": "AurumCode polyglot toolchain profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "polyglot_root", "toolchain_source", "toolchain_materialization", "toolchain_install", "toolchain_bootstrap", "package_install", "package_registry", "package_installs", "cache_mode", "telemetry", "egress", "host_toolchain", "host_cache", "host_filesystem", "subprocess", "unregistered_language", "languages", "toolchains", "max_languages", "max_packages", "max_package_bytes", "max_cache_bytes", "resolve_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.polyglot-toolchain-profile"},
    "version": {"const": 1},
    "profile": {"const": "polyglot-toolchain-v1"},
    "lock": {"const": ".board/locks/oci/polyglot-toolchain-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "polyglot_root": {"const": "/tmp/aurum-polyglot"},
    "toolchain_source": {"const": "digest-pinned"},
    "toolchain_materialization": {"const": "pre-materialized"},
    "toolchain_install": {"const": "denied"},
    "toolchain_bootstrap": {"const": "denied"},
    "package_install": {"const": "denied"},
    "package_registry": {"const": "denied"},
    "package_installs": {"const": 0},
    "cache_mode": {"const": "read-only"},
    "telemetry": {"const": "denied"},
    "egress": {"const": "denied"},
    "host_toolchain": {"const": "denied"},
    "host_cache": {"const": "denied"},
    "host_filesystem": {"const": "denied"},
    "subprocess": {"const": "denied"},
    "unregistered_language": {"const": "denied"},
    "languages": {"const": ["bash", "c-cpp", "dotnet", "javascript", "powershell", "python", "rust", "typescript"]},
    "toolchains": {"type": "object", "additionalProperties": false, "required": ["bash", "c-cpp", "dotnet", "javascript", "powershell", "python", "rust", "typescript"], "properties": {"bash": {"const": {"runtime": "bash", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/bash", "cache_mode": "read-only", "telemetry": "denied"}}, "c-cpp": {"const": {"runtime": "cc", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/c-cpp", "cache_mode": "read-only", "telemetry": "denied"}}, "dotnet": {"const": {"runtime": "dotnet", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/dotnet", "cache_mode": "read-only", "telemetry": "denied"}}, "javascript": {"const": {"runtime": "node", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/javascript", "cache_mode": "read-only", "telemetry": "denied"}}, "powershell": {"const": {"runtime": "pwsh", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/powershell", "cache_mode": "read-only", "telemetry": "denied"}}, "python": {"const": {"runtime": "python3", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/python", "cache_mode": "read-only", "telemetry": "denied"}}, "rust": {"const": {"runtime": "cargo", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/rust", "cache_mode": "read-only", "telemetry": "denied"}}, "typescript": {"const": {"runtime": "tsc", "toolchain": "digest-pinned", "cache_root": "/tmp/aurum-polyglot/typescript", "cache_mode": "read-only", "telemetry": "denied"}}}},
    "max_languages": {"const": 8},
    "max_packages": {"const": 4096},
    "max_package_bytes": {"const": 16384},
    "max_cache_bytes": {"const": 8388608},
    "resolve_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "CGO_ENABLED", "AURUM_POLYGLOT_ROOT", "PIP_NO_INDEX", "PIP_DISABLE_PIP_VERSION_CHECK", "NPM_CONFIG_OFFLINE", "NPM_CONFIG_REGISTRY", "NUGET_PACKAGES", "DOTNET_CLI_TELEMETRY_OPTOUT", "DOTNET_NOLOGO", "CARGO_HOME", "CARGO_NET_OFFLINE", "POWERSHELL_TELEMETRY_OPTOUT", "POWERSHELL_UPDATECHECK", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "CGO_ENABLED": {"const": "0"}, "AURUM_POLYGLOT_ROOT": {"const": "/tmp/aurum-polyglot"}, "PIP_NO_INDEX": {"const": "1"}, "PIP_DISABLE_PIP_VERSION_CHECK": {"const": "1"}, "NPM_CONFIG_OFFLINE": {"const": "true"}, "NPM_CONFIG_REGISTRY": {"const": ""}, "NUGET_PACKAGES": {"const": "/tmp/aurum-polyglot/dotnet"}, "DOTNET_CLI_TELEMETRY_OPTOUT": {"const": "1"}, "DOTNET_NOLOGO": {"const": "1"}, "CARGO_HOME": {"const": "/tmp/aurum-polyglot/rust"}, "CARGO_NET_OFFLINE": {"const": "true"}, "POWERSHELL_TELEMETRY_OPTOUT": {"const": "1"}, "POWERSHELL_UPDATECHECK": {"const": "Off"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
