{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurumcode.dev/schemas/fake-scm-offline-profile.schema.json",
  "title": "AurumCode offline fake SCM profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "lock", "lock_digest", "network", "user", "cap_drop", "cap_add", "mounts", "devices", "sockets", "pull", "tmpfs", "checkout_readonly", "read_only_rootfs", "no_new_privileges", "privileged", "timeout_seconds", "memory_mb", "cpu_millis", "pids_limit", "tmpfs_mb", "stdout_limit_bytes", "stderr_limit_bytes", "max_input_files", "max_input_bytes", "module_cache", "module_cache_read_only", "scm_backend", "real_scm_binary", "fake_scm", "fake_scm_cgo", "fake_scm_root", "event_set", "event_root", "response_set", "repository_mode", "repository_root", "remote_origin", "remote_protocols", "custom_transport", "credential_helper", "askpass", "hooks", "submodules", "url_rewriting", "publication", "external_destination", "token", "credential_sources", "host_checkout", "host_filesystem", "subprocess", "max_events", "max_event_bytes", "max_responses", "max_response_bytes", "max_repository_bytes", "scm_timeout_seconds", "environment", "command"],
  "properties": {
    "schema": {"const": "aurum.fake-scm-offline-profile"},
    "version": {"const": 1},
    "profile": {"const": "fake-scm-offline-v1"},
    "lock": {"const": ".board/locks/oci/fake-scm-offline-v1.lock.json"},
    "lock_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "network": {"const": "none"},
    "user": {"const": "65534:65534"},
    "cap_drop": {"const": "ALL"},
    "cap_add": {"const": "none"},
    "mounts": {"const": "none"},
    "devices": {"const": "none"},
    "sockets": {"const": "none"},
    "pull": {"const": "never"},
    "tmpfs": {"const": "rw,nosuid,nodev"},
    "checkout_readonly": {"const": true},
    "read_only_rootfs": {"const": true},
    "no_new_privileges": {"const": true},
    "privileged": {"const": false},
    "timeout_seconds": {"const": 60},
    "memory_mb": {"const": 256},
    "cpu_millis": {"const": 1000},
    "pids_limit": {"const": 128},
    "tmpfs_mb": {"const": 128},
    "stdout_limit_bytes": {"const": 65536},
    "stderr_limit_bytes": {"const": 65536},
    "max_input_files": {"const": 10000},
    "max_input_bytes": {"const": 67108864},
    "module_cache": {"const": "/go/pkg/mod"},
    "module_cache_read_only": {"const": true},
    "scm_backend": {"const": "fake-local"},
    "real_scm_binary": {"const": "denied"},
    "fake_scm": {"const": "digest-pinned"},
    "fake_scm_cgo": {"const": false},
    "fake_scm_root": {"const": "/tmp/aurum-fake-scm-engine"},
    "event_set": {"const": "digest-pinned"},
    "event_root": {"const": "/tmp/aurum-fake-scm-events"},
    "response_set": {"const": "digest-pinned"},
    "repository_mode": {"const": "ephemeral"},
    "repository_root": {"const": "/tmp/aurum-fake-scm-repos"},
    "remote_origin": {"const": "absent"},
    "remote_protocols": {"const": ["fake"]},
    "custom_transport": {"const": "denied"},
    "credential_helper": {"const": "denied"},
    "askpass": {"const": "denied"},
    "hooks": {"const": "denied"},
    "submodules": {"const": "denied"},
    "url_rewriting": {"const": "denied"},
    "publication": {"const": "denied"},
    "external_destination": {"const": "denied"},
    "token": {"const": "absent"},
    "credential_sources": {"const": "denied"},
    "host_checkout": {"const": "denied"},
    "host_filesystem": {"const": "denied"},
    "subprocess": {"const": "denied"},
    "max_events": {"const": 1024},
    "max_event_bytes": {"const": 65536},
    "max_responses": {"const": 64},
    "max_response_bytes": {"const": 65536},
    "max_repository_bytes": {"const": 33554432},
    "scm_timeout_seconds": {"const": 5},
    "environment": {"type": "object", "additionalProperties": false, "required": ["GOPROXY", "GOSUMDB", "GONOSUMDB", "GOTOOLCHAIN", "CGO_ENABLED", "AURUM_FAKE_SCM_ROOT", "AURUM_FAKE_SCM_EVENT_ROOT", "AURUM_FAKE_SCM_REPOSITORY_ROOT", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_TERMINAL_PROMPT", "GIT_ASKPASS", "GIT_ALLOW_PROTOCOL", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY"], "properties": {"GOPROXY": {"const": "off"}, "GOSUMDB": {"const": "off"}, "GONOSUMDB": {"const": "*"}, "GOTOOLCHAIN": {"const": "local"}, "CGO_ENABLED": {"const": "0"}, "AURUM_FAKE_SCM_ROOT": {"const": "/tmp/aurum-fake-scm-engine"}, "AURUM_FAKE_SCM_EVENT_ROOT": {"const": "/tmp/aurum-fake-scm-events"}, "AURUM_FAKE_SCM_REPOSITORY_ROOT": {"const": "/tmp/aurum-fake-scm-repos"}, "GIT_CONFIG_NOSYSTEM": {"const": "1"}, "GIT_CONFIG_GLOBAL": {"const": "/dev/null"}, "GIT_CONFIG_SYSTEM": {"const": "/dev/null"}, "GIT_TERMINAL_PROMPT": {"const": "0"}, "GIT_ASKPASS": {"const": "/bin/false"}, "GIT_ALLOW_PROTOCOL": {"const": "none"}, "HTTP_PROXY": {"const": ""}, "HTTPS_PROXY": {"const": ""}, "NO_PROXY": {"const": "*"}}},
    "command": {"const": ["go", "test", "-mod=readonly", "./..."]}
  }
}
