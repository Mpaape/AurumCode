# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log

# Dependency directories
node_modules/

# Environment variables
.env

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS specific
.DS_Store

# Go specific
bin/
# The board runner is source, not Go build output — `bin/` above would swallow it.
!.board/bin/
# Acceptance fixtures ship their own .board/bin replicas; the bin/ rule above
# must not silently swallow them out of a normal git add -A.
!tests/**/.board/bin/
dist/
# `go build` with no -o drops the binary at the repo root under the package name.
/regenerate-docs
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
vendor/
go.work
go.work.sum

# Build and test artifacts
*.cover
*.test.exe
__debug_bin

# Backup and temporary files
*~
*.bak
*.tmp
*.swp

# Secrets and credentials
*.key
*.pem
credentials.json
secrets.yaml
secrets.yml

# CI/CD artifacts
.artifacts/
reports/

# AurumCode generated documentation
.aurumcode/_site/
.aurumcode/.jekyll-cache/
.aurumcode/.sass-cache/
.aurumcode/vendor/
.aurumcode/node_modules/
.aurumcode/Gemfile.lock
# Keep .aurumcode/ directory structure and config files
!.aurumcode/
!.aurumcode/_config.yml
!.aurumcode/Gemfile
!.aurumcode/.gitignore

# Task files
# tasks.json
# tasks/ 

# ai-memory install-instructions backups
CLAUDE.md.bak-*
AGENTS.md.bak-*
