{
 "rules": [
  {
   "context": "code-outside-string-literals",
   "description": "Credential-named identifier assigned an inline quoted literal of 8+ characters",
   "id": "aurumcode-keyword-assignment",
   "regex": "(?i)\\b(?:[a-z][a-z0-9]*)?(?:api[_-]?key|secret|password|passwd|token|credential|access[_-]?key)s?\\b\\s*[:=]=?\\s*[\"'][^\"'\\r\\n]{8,}[\"']"
  }
 ],
 "schema": "aurumcode-secret-rules-local-v1"
}
